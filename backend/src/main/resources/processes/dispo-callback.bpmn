<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_DispoCallback"
                  targetNamespace="http://heizoel.backend/camunda">

    <bpmn:process id="dispo-callback-process"
                  name="DISPO Callback Process"
                  isExecutable="true"
                  camunda:historyTimeToLive="30">

        <bpmn:startEvent id="StartEvent_DispoCallbackRequested"
                         name="DISPO callback requested">
            <bpmn:outgoing>Flow_Start_To_SendCallback</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:serviceTask id="ServiceTask_SendDispoCallback"
                          name="Send DISPO callback"
                          camunda:delegateExpression="${dispoCallbackDelegate}"
                          camunda:asyncBefore="true">

            <bpmn:extensionElements>
                <camunda:failedJobRetryTimeCycle>R5/PT1M</camunda:failedJobRetryTimeCycle>
            </bpmn:extensionElements>

            <bpmn:incoming>Flow_Start_To_SendCallback</bpmn:incoming>
            <bpmn:outgoing>Flow_SendCallback_To_End</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_DispoCallbackDelivered"
                       name="DISPO callback delivered">
            <bpmn:incoming>Flow_SendCallback_To_End</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_Start_To_SendCallback"
                           sourceRef="StartEvent_DispoCallbackRequested"
                           targetRef="ServiceTask_SendDispoCallback"/>

        <bpmn:sequenceFlow id="Flow_SendCallback_To_End"
                           sourceRef="ServiceTask_SendDispoCallback"
                           targetRef="EndEvent_DispoCallbackDelivered"/>

    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_DispoCallback">
        <bpmndi:BPMNPlane id="BPMNPlane_DispoCallback"
                          bpmnElement="dispo-callback-process">

            <bpmndi:BPMNShape id="Shape_StartEvent"
                              bpmnElement="StartEvent_DispoCallbackRequested">
                <dc:Bounds x="160" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Shape_ServiceTask"
                              bpmnElement="ServiceTask_SendDispoCallback">
                <dc:Bounds x="260" y="78" width="160" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Shape_EndEvent"
                              bpmnElement="EndEvent_DispoCallbackDelivered">
                <dc:Bounds x="500" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Edge_Flow_Start_To_SendCallback"
                             bpmnElement="Flow_Start_To_SendCallback">
                <di:waypoint x="196" y="118"/>
                <di:waypoint x="260" y="118"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Edge_Flow_SendCallback_To_End"
                             bpmnElement="Flow_SendCallback_To_End">
                <di:waypoint x="420" y="118"/>
                <di:waypoint x="500" y="118"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</bpmn:definitions>