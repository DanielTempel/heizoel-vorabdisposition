<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Rueckbestaetigung_Heizoel" targetNamespace="http://example.com/rueckbestaetigung-heizoel" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:message id="Message_CustomerAnswer" name="Kundenantwort eingegangen" />
  <bpmn:process id="Process_Rueckbestaetigung_Heizoel" name="Digitale Rückbestätigung geplanter Heizöl-Lieferungen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Disponent" name="Disponent" />
      <bpmn:lane id="Lane_System" name="Rückbestätigungssystem" />
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_OrderAvailable" name="Auftrag im DISPO-System vorhanden">
      <bpmn:outgoing>Flow_Start_To_PlanTour</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PlanTour" name="Tour vorläufig planen">
      <bpmn:incoming>Flow_Start_To_PlanTour</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanTour_To_TriggerRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectOrderAndTriggerRequest" name="Rückbestätigung für Auftrag manuell starten">
      <bpmn:incoming>Flow_PlanTour_To_TriggerRequest</bpmn:incoming>
      <bpmn:incoming>Flow_NewWindow_To_TriggerRequest</bpmn:incoming>
      <bpmn:incoming>Flow_Removed_To_CheckTour</bpmn:incoming>
      <bpmn:outgoing>Flow_TriggerRequest_To_SendRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendRequest" name="Anfrage an Kunden senden">
      <bpmn:incoming>Flow_TriggerRequest_To_SendRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_14yy040</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetStatusSentStartTimer" name="Status versendet setzen und 24h-Frist starten">
      <bpmn:incoming>Flow_14yy040</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusSent_To_Wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_WaitForResponseOrTimeout" name="Warten auf Antwort oder Fristablauf">
      <bpmn:incoming>Flow_StatusSent_To_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_To_CustomerAnswer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_To_TimerExpired</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_CustomerAnswerReceived" name="Kundenantwort eingegangen">
      <bpmn:incoming>Flow_Wait_To_CustomerAnswer</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerAnswer_To_Validate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CustomerAnswer" messageRef="Message_CustomerAnswer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Timer24hExpired" name="24 Stunden ohne gültige Antwort">
      <bpmn:incoming>Flow_Wait_To_TimerExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerExpired_To_NoResponse</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_24h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ResponseValid" name="Antwort gültig?">
      <bpmn:incoming>Flow_CustomerAnswer_To_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_ResponseValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResponseValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_IgnoreInvalidAnswer" name="Antwort ignorieren, Status nicht ändern">
      <bpmn:incoming>Flow_ResponseValid_No</bpmn:incoming>
      <bpmn:outgoing>Flow_IgnoreInvalid_To_EndNoStatusChange</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CustomerDecision" name="Kundenentscheidung">
      <bpmn:incoming>Flow_ResponseValid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Confirmed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SetStatusConfirmed" name="Status bestätigt setzen">
      <bpmn:incoming>Flow_Decision_Confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_To_CheckTour</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetStatusRejected" name="Status abgelehnt setzen">
      <bpmn:incoming>Flow_Decision_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected_To_ManualHandling</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetStatusNoResponse" name="Status keine Rückmeldung setzen">
      <bpmn:incoming>Flow_TimerExpired_To_NoResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_NoResponse_To_ManualHandling</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ManualHandling" name="Problemfall manuell bearbeiten">
      <bpmn:incoming>Flow_Rejected_To_ManualHandling</bpmn:incoming>
      <bpmn:incoming>Flow_NoResponse_To_ManualHandling</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualHandling_To_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManualDecision" name="Entscheidung des Disponenten">
      <bpmn:incoming>Flow_ManualHandling_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual_NewWindow</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual_Phone</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual_MoveOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_NewDeliveryWindow" name="Neues Lieferfenster festlegen">
      <bpmn:incoming>Flow_Manual_NewWindow</bpmn:incoming>
      <bpmn:outgoing>Flow_NewWindow_To_TriggerRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PhoneClarification" name="Telefonisch klären">
      <bpmn:incoming>Flow_Manual_Phone</bpmn:incoming>
      <bpmn:outgoing>Flow_Phone_To_MarkConfirmedManual</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_MarkConfirmedManual" name="Status bestätigt manuell setzen">
      <bpmn:incoming>Flow_Phone_To_MarkConfirmedManual</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualConfirmed_To_CheckTour</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MoveOrder" name="Auftrag auf andere Tour verschieben">
      <bpmn:incoming>Flow_Manual_MoveOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_MoveOrder_To_RemoveFromTour</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RemoveFromCurrentTour" name="Neues Lieferfenster festlegen">
      <bpmn:incoming>Flow_MoveOrder_To_RemoveFromTour</bpmn:incoming>
      <bpmn:outgoing>Flow_Removed_To_CheckTour</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AllRelevantOrdersClarified" name="Alle relevanten Aufträge der Tour geklärt?">
      <bpmn:incoming>Flow_Confirmed_To_CheckTour</bpmn:incoming>
      <bpmn:incoming>Flow_ManualConfirmed_To_CheckTour</bpmn:incoming>
      <bpmn:outgoing>Flow_AllClarified_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_MarkTourReady" name="Tour als freigabebereit anzeigen">
      <bpmn:incoming>Flow_AllClarified_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_TourReady_To_FinalRelease</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_FinalReleaseTour" name="Tour final freigeben">
      <bpmn:incoming>Flow_TourReady_To_FinalRelease</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalRelease_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Prozess abgeschlossen">
      <bpmn:incoming>Flow_FinalRelease_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NoStatusChange" name="Keine Statusänderung">
      <bpmn:incoming>Flow_IgnoreInvalid_To_EndNoStatusChange</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_PlanTour" sourceRef="StartEvent_OrderAvailable" targetRef="Task_PlanTour" />
    <bpmn:sequenceFlow id="Flow_PlanTour_To_TriggerRequest" sourceRef="Task_PlanTour" targetRef="Task_SelectOrderAndTriggerRequest" />
    <bpmn:sequenceFlow id="Flow_TriggerRequest_To_SendRequest" sourceRef="Task_SelectOrderAndTriggerRequest" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="Flow_StatusSent_To_Wait" sourceRef="Task_SetStatusSentStartTimer" targetRef="Gateway_WaitForResponseOrTimeout" />
    <bpmn:sequenceFlow id="Flow_Wait_To_CustomerAnswer" sourceRef="Gateway_WaitForResponseOrTimeout" targetRef="Event_CustomerAnswerReceived" />
    <bpmn:sequenceFlow id="Flow_Wait_To_TimerExpired" sourceRef="Gateway_WaitForResponseOrTimeout" targetRef="Event_Timer24hExpired" />
    <bpmn:sequenceFlow id="Flow_CustomerAnswer_To_Validate" sourceRef="Event_CustomerAnswerReceived" targetRef="Gateway_ResponseValid" />
    <bpmn:sequenceFlow id="Flow_ResponseValid_Yes" name="Ja" sourceRef="Gateway_ResponseValid" targetRef="Gateway_CustomerDecision" />
    <bpmn:sequenceFlow id="Flow_ResponseValid_No" name="Nein" sourceRef="Gateway_ResponseValid" targetRef="Task_IgnoreInvalidAnswer" />
    <bpmn:sequenceFlow id="Flow_IgnoreInvalid_To_EndNoStatusChange" sourceRef="Task_IgnoreInvalidAnswer" targetRef="EndEvent_NoStatusChange" />
    <bpmn:sequenceFlow id="Flow_Decision_Confirmed" name="bestätigt" sourceRef="Gateway_CustomerDecision" targetRef="Task_SetStatusConfirmed" />
    <bpmn:sequenceFlow id="Flow_Decision_Rejected" name="abgelehnt" sourceRef="Gateway_CustomerDecision" targetRef="Task_SetStatusRejected" />
    <bpmn:sequenceFlow id="Flow_TimerExpired_To_NoResponse" sourceRef="Event_Timer24hExpired" targetRef="Task_SetStatusNoResponse" />
    <bpmn:sequenceFlow id="Flow_Confirmed_To_CheckTour" sourceRef="Task_SetStatusConfirmed" targetRef="Gateway_AllRelevantOrdersClarified" />
    <bpmn:sequenceFlow id="Flow_Rejected_To_ManualHandling" sourceRef="Task_SetStatusRejected" targetRef="Task_ManualHandling" />
    <bpmn:sequenceFlow id="Flow_NoResponse_To_ManualHandling" sourceRef="Task_SetStatusNoResponse" targetRef="Task_ManualHandling" />
    <bpmn:sequenceFlow id="Flow_ManualHandling_To_Decision" sourceRef="Task_ManualHandling" targetRef="Gateway_ManualDecision" />
    <bpmn:sequenceFlow id="Flow_Manual_NewWindow" name="neues Lieferfenster" sourceRef="Gateway_ManualDecision" targetRef="Task_NewDeliveryWindow" />
    <bpmn:sequenceFlow id="Flow_Manual_Phone" name="telefonisch klären" sourceRef="Gateway_ManualDecision" targetRef="Task_PhoneClarification" />
    <bpmn:sequenceFlow id="Flow_Manual_MoveOrder" name="verschieben" sourceRef="Gateway_ManualDecision" targetRef="Task_MoveOrder" />
    <bpmn:sequenceFlow id="Flow_NewWindow_To_TriggerRequest" sourceRef="Task_NewDeliveryWindow" targetRef="Task_SelectOrderAndTriggerRequest" />
    <bpmn:sequenceFlow id="Flow_Phone_To_MarkConfirmedManual" sourceRef="Task_PhoneClarification" targetRef="Task_MarkConfirmedManual" />
    <bpmn:sequenceFlow id="Flow_ManualConfirmed_To_CheckTour" sourceRef="Task_MarkConfirmedManual" targetRef="Gateway_AllRelevantOrdersClarified" />
    <bpmn:sequenceFlow id="Flow_MoveOrder_To_RemoveFromTour" sourceRef="Task_MoveOrder" targetRef="Task_RemoveFromCurrentTour" />
    <bpmn:sequenceFlow id="Flow_Removed_To_CheckTour" sourceRef="Task_RemoveFromCurrentTour" targetRef="Task_SelectOrderAndTriggerRequest" />
    <bpmn:sequenceFlow id="Flow_AllClarified_Yes" name="Ja" sourceRef="Gateway_AllRelevantOrdersClarified" targetRef="Task_MarkTourReady" />
    <bpmn:sequenceFlow id="Flow_TourReady_To_FinalRelease" sourceRef="Task_MarkTourReady" targetRef="Task_FinalReleaseTour" />
    <bpmn:sequenceFlow id="Flow_FinalRelease_To_End" sourceRef="Task_FinalReleaseTour" targetRef="EndEvent_ProcessFinished" />
    <bpmn:sequenceFlow id="Flow_14yy040" sourceRef="Task_SendRequest" targetRef="Task_SetStatusSentStartTimer" />
  </bpmn:process>
