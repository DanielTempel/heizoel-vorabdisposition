<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Ist_Lieferbestaetigung" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:process id="Process_Ist_Lieferbestaetigung" name="IST-Prozess: Lieferbestätigung in der Disposition" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Ist_Prozess">
      <bpmn:lane id="Lane_Disposition" name="Disposition">
        <bpmn:flowNodeRef>StartEvent_AuftragVorhanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragsdatenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragWeiterInPlanung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KundeRuftSpaeterZurueck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KapazitaetPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KapazitaetVorhanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragInNaechsteFreieTourVerschieben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragsdatenNennen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerminDokumentieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragFinalInTourSperren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuftragFinalGeplant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AenderungswunschAufnehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AlternativesZeitfensterPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuftragVerschoben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TourVorlaeufigPlanen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LieferfensterFestlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KundeAnrufen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KundeErreicht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ErgebnisDokumentieren_NichtErreicht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WeitereAnrufeSinnvoll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimer_ErneuterAnruf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InTourAufnehmbar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragInnerhalbTourAnpassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlternativeMoeglich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisponentEntscheidetEinzelfall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AlternativeKontaktwegeNutzen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kunde" name="Kunde">
        <bpmn:flowNodeRef>Task_KundeReagiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KundeBestaetigtTermin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KundeLehntTerminAb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TerminBestaetigt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_AuftragVorhanden" name="Auftrag ist im System vorhanden">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_AuftragsdatenPruefen" name="Auftragsdaten und Lieferzeitraum prüfen">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TourVorlaeufigPlanen" name="Vorläufige Tour planen">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LieferfensterFestlegen" name="Liefertag und konkretes Lieferfenster festlegen">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KundeAnrufen" name="Kunden telefonisch kontaktieren">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_KundeErreicht" name="Kunde erreicht?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ErgebnisDokumentieren_NichtErreicht" name="Nichterreichbarkeit dokumentieren">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WeitereAnrufeSinnvoll" name="Weiterer Anruf sinnvoll?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IntermediateTimer_ErneuterAnruf" name="Einige Stunden warten">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ErneuterAnruf" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_AuftragWeiterInPlanung" name="Auftrag bleibt auf Basis des angegebenen Lieferzeitraums in Planung">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_KundeRuftSpaeterZurueck" name="Kunde ruft später zurück?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KapazitaetPruefen" name="Freie Kapazität in ursprünglicher Tour prüfen">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_KapazitaetVorhanden" name="Kapazität vorhanden?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AuftragInNaechsteFreieTourVerschieben" name="Auftrag auf nächste freie Tour verschieben">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AuftragsdatenNennen" name="Preis, Lieferadresse, Lieferdatum und Lieferfenster nennen">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KundeReagiert" name="Kunde reagiert auf Terminvorschlag">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TerminBestaetigt" name="Termin eindeutig bestätigt?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KundeBestaetigtTermin" name="Kunde bestätigt konkretes Lieferfenster">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TerminDokumentieren" name="Bestätigung im DISPO-System dokumentieren">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AuftragFinalInTourSperren" name="Auftrag final in Tour einplanen und für Änderungen sperren">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AuftragFinalGeplant" name="Auftrag final geplant">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_KundeLehntTerminAb" name="Kunde lehnt Termin ab oder äußert Änderungswunsch">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AenderungswunschAufnehmen" name="Änderungswunsch aufnehmen">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AlternativesZeitfensterPruefen" name="Alternatives Zeitfenster innerhalb der aktuellen Tour prüfen">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AlternativeMoeglich" name="Alternative innerhalb der Tour möglich?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AuftragInnerhalbTourAnpassen" name="Auftrag innerhalb der Tour anpassen">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DisponentEntscheidetEinzelfall" name="Disponent entscheidet im Einzelfall bei Konflikten">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_InTourAufnehmbar" name="Aufnahme in Tour möglich?">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AlternativeKontaktwegeNutzen" name="Alternative Kontaktwege manuell nutzen">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AuftragVerschoben" name="Auftrag verschoben">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuftragVorhanden" targetRef="Task_AuftragsdatenPruefen" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AuftragsdatenPruefen" targetRef="Task_TourVorlaeufigPlanen" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TourVorlaeufigPlanen" targetRef="Task_LieferfensterFestlegen" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_LieferfensterFestlegen" targetRef="Task_KundeAnrufen" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_KundeAnrufen" targetRef="Gateway_KundeErreicht" />
    <bpmn:sequenceFlow id="Flow_06" name="Ja" sourceRef="Gateway_KundeErreicht" targetRef="Task_AuftragsdatenNennen" />
    <bpmn:sequenceFlow id="Flow_07" name="Nein" sourceRef="Gateway_KundeErreicht" targetRef="Task_ErgebnisDokumentieren_NichtErreicht" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ErgebnisDokumentieren_NichtErreicht" targetRef="Gateway_WeitereAnrufeSinnvoll" />
    <bpmn:sequenceFlow id="Flow_09" name="Ja" sourceRef="Gateway_WeitereAnrufeSinnvoll" targetRef="IntermediateTimer_ErneuterAnruf" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="IntermediateTimer_ErneuterAnruf" targetRef="Task_KundeAnrufen" />
    <bpmn:sequenceFlow id="Flow_11" name="Nein" sourceRef="Gateway_WeitereAnrufeSinnvoll" targetRef="Task_AuftragWeiterInPlanung" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AuftragWeiterInPlanung" targetRef="Gateway_KundeRuftSpaeterZurueck" />
    <bpmn:sequenceFlow id="Flow_13" name="Ja" sourceRef="Gateway_KundeRuftSpaeterZurueck" targetRef="Task_KapazitaetPruefen" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_KapazitaetPruefen" targetRef="Gateway_KapazitaetVorhanden" />
    <bpmn:sequenceFlow id="Flow_15" name="Ja" sourceRef="Gateway_KapazitaetVorhanden" targetRef="Task_AuftragsdatenNennen" />
    <bpmn:sequenceFlow id="Flow_16" name="Nein" sourceRef="Gateway_KapazitaetVorhanden" targetRef="Task_AuftragInNaechsteFreieTourVerschieben" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_AuftragInNaechsteFreieTourVerschieben" targetRef="EndEvent_AuftragVerschoben" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_AuftragsdatenNennen" targetRef="Task_KundeReagiert" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_KundeReagiert" targetRef="Gateway_TerminBestaetigt" />
    <bpmn:sequenceFlow id="Flow_20" name="Ja" sourceRef="Gateway_TerminBestaetigt" targetRef="Task_KundeBestaetigtTermin" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_KundeBestaetigtTermin" targetRef="Task_TerminDokumentieren" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_TerminDokumentieren" targetRef="Task_AuftragFinalInTourSperren" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_AuftragFinalInTourSperren" targetRef="EndEvent_AuftragFinalGeplant" />
    <bpmn:sequenceFlow id="Flow_24" name="Nein" sourceRef="Gateway_TerminBestaetigt" targetRef="Task_KundeLehntTerminAb" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_KundeLehntTerminAb" targetRef="Task_AenderungswunschAufnehmen" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_AenderungswunschAufnehmen" targetRef="Task_AlternativesZeitfensterPruefen" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_AlternativesZeitfensterPruefen" targetRef="Gateway_AlternativeMoeglich" />
    <bpmn:sequenceFlow id="Flow_28" name="Ja" sourceRef="Gateway_AlternativeMoeglich" targetRef="Task_AuftragInnerhalbTourAnpassen" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_AuftragInnerhalbTourAnpassen" targetRef="Task_TerminDokumentieren" />
    <bpmn:sequenceFlow id="Flow_30" name="Nein / Konflikt" sourceRef="Gateway_AlternativeMoeglich" targetRef="Task_DisponentEntscheidetEinzelfall" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_DisponentEntscheidetEinzelfall" targetRef="Gateway_InTourAufnehmbar" />
    <bpmn:sequenceFlow id="Flow_33" name="Nein" sourceRef="Gateway_InTourAufnehmbar" targetRef="Task_AuftragInNaechsteFreieTourVerschieben" />
    <bpmn:sequenceFlow id="Flow_34" name="Ja" sourceRef="Gateway_InTourAufnehmbar" targetRef="Task_AuftragInnerhalbTourAnpassen" />
    <bpmn:sequenceFlow id="Flow_40" name="Nein / keine Rückmeldung" sourceRef="Gateway_KundeRuftSpaeterZurueck" targetRef="Task_AlternativeKontaktwegeNutzen" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_AlternativeKontaktwegeNutzen" targetRef="Task_AuftragWeiterInPlanung" />
  </bpmn:process>
